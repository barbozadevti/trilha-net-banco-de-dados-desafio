<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <!-- Os scripts SQL da raiz do repositório acompanham a aplicação. -->
  <ItemGroup>
    <None Include="..\..\database\**\*.sql" LinkBase="database" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
